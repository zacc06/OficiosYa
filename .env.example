# Copia a .env y reemplaza los valores locales.
DATABASE_URL=postgresql+psycopg://oficiosya_app:CAMBIAR_PASSWORD@127.0.0.1:5432/oficiosya
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_LARGA
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0
UPLOAD_FOLDER=uploads
